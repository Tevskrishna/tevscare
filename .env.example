# Copy to .env at the repository root. These values are for local Docker only.
# Do not reuse them in a shared or production environment.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=tevscare;Username=tevscare;Password=tevscare_dev_password
Jwt__SigningKey=replace-with-a-local-key-of-at-least-32-chars
Jwt__Issuer=tevscare
Jwt__Audience=tevscare-mobile
ASPNETCORE_ENVIRONMENT=Development
EXPO_PUBLIC_API_URL=http://localhost:5080
