# Copy to .env at the repository root. Values below are local Docker placeholders, not production secrets.

ASPNETCORE_ENVIRONMENT=Development
# This password matches docker-compose.yml and is only for the local database.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tevscare;Username=tevscare;Password=tevscare_dev_password
Jwt__SigningKey=replace-with-a-local-key-of-at-least-32-characters
Jwt__Issuer=tevscare
Jwt__Audience=tevscare-mobile

# Development only. Production ignores SeedDemoData even if this is true.
Tevscare__SeedDemoData=true
Tevscare__ExposeResetTokens=true
Tevscare__ApplyMigrations=true
Tevscare__TrustForwardedHeaders=false

# Browser origins for Staging and Production. Native apps do not use CORS.
# Cors__Origins__0=https://admin.example
